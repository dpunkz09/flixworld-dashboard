---
import Layout from '../layouts/Layout.astro';
import { getNetflixTopItems } from '../lib/supabase';
import { enrichItems, posterUrl, displayTitle, displayYear } from '../lib/tmdb';
import type { SupabaseItem } from '../lib/supabase';
import type { TmdbMedia } from '../lib/tmdb';

let items: SupabaseItem[] = [];
let enriched: (TmdbMedia | null)[] = [];
let error = '';

try {
  items = await getNetflixTopItems();
  enriched = await enrichItems(items);
} catch (e: any) {
  error = e.message;
}
---

<Layout title="Netflix Top Items">
  {error && (
    <div class="mb-6 rounded-lg bg-red-900/40 border border-red-700 px-4 py-3 text-red-300 text-sm">
      ⚠️ {error}
    </div>
  )}

  <!-- Toolbar -->
  <div class="flex items-center justify-between mb-6">
    <p class="text-sm text-gray-400">{items.length} item{items.length !== 1 ? 's' : ''} in Netflix Top</p>
    <button
      id="add-btn"
      class="flex items-center gap-2 bg-red-600 hover:bg-red-500 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
    >
      <span>＋</span> Add Item
    </button>
  </div>

  <!-- Ranked grid -->
  <div id="items-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
    {items.map((item, i) => {
      const meta = enriched[i];
      const title = meta ? displayTitle(meta) : `TMDB #${item.tmdb_id}`;
      const year = meta ? displayYear(meta) : '—';
      const poster = meta ? posterUrl(meta.poster_path) : '/placeholder-poster.svg';
      const rank = i + 1;
      return (
        <div
          class="media-card group relative bg-gray-900 rounded-xl overflow-hidden border border-gray-800 hover:border-red-500 transition-all"
          data-id={item.id}
          data-tmdb-id={item.tmdb_id}
          data-type={item.type}
        >
          <!-- Rank badge -->
          <div class="absolute top-0 left-0 z-10 w-9 h-9 flex items-end justify-end pr-1 pb-0.5">
            <span class="text-2xl font-black text-white drop-shadow-[0_1px_4px_rgba(0,0,0,0.9)] leading-none"
              style="text-shadow: -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;">
              {rank}
            </span>
          </div>
          <img
            src={poster}
            alt={title}
            class="w-full aspect-[2/3] object-cover"
            loading="lazy"
          />
          <!-- Type badge -->
          <span class={`absolute top-2 right-2 text-xs font-bold uppercase px-2 py-0.5 rounded-full ${item.type === 'movie' ? 'bg-indigo-600' : 'bg-emerald-600'}`}>
            {item.type}
          </span>
          <!-- Info -->
          <div class="p-3">
            <p class="text-sm font-medium text-white truncate" title={title}>{title}</p>
            <p class="text-xs text-gray-500">{year}</p>
          </div>
          <!-- Hover actions -->
          <div class="absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-3">
            <button
              class="replace-btn w-28 bg-red-600 hover:bg-red-500 text-white text-xs font-semibold py-2 rounded-lg transition-colors"
              data-id={item.id}
              data-tmdb-id={item.tmdb_id}
              data-type={item.type}
            >
              🔄 Replace
            </button>
            <button
              class="delete-btn w-28 bg-gray-700 hover:bg-gray-600 text-white text-xs font-semibold py-2 rounded-lg transition-colors"
              data-id={item.id}
            >
              🗑 Delete
            </button>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty state -->
  {items.length === 0 && !error && (
    <div class="flex flex-col items-center justify-center py-24 text-gray-600">
      <span class="text-5xl mb-4">🔥</span>
      <p class="text-lg">No Netflix Top items yet</p>
      <p class="text-sm mt-1">Click <strong class="text-gray-400">Add Item</strong> to get started</p>
    </div>
  )}

  <!-- ── Modals ── -->

  <!-- Search / Add Modal -->
  <div id="search-modal" class="modal-backdrop hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4">
    <div class="modal-box bg-gray-900 border border-gray-700 rounded-2xl w-full max-w-2xl shadow-2xl flex flex-col max-h-[90vh]">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-800">
        <h2 class="text-base font-semibold text-white" id="modal-title">Add Netflix Top Item</h2>
        <button id="close-modal" class="text-gray-500 hover:text-white text-xl leading-none">✕</button>
      </div>

      <div class="px-6 py-4 border-b border-gray-800">
        <div class="flex gap-2">
          <input
            id="search-input"
            type="text"
            placeholder="Search movies & TV shows…"
            class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-red-500"
          />
          <button id="search-btn" class="bg-red-600 hover:bg-red-500 text-white text-sm font-medium px-5 py-2.5 rounded-lg transition-colors">
            Search
          </button>
        </div>
        <p id="search-status" class="text-xs text-gray-500 mt-2 min-h-[16px]"></p>
      </div>

      <div id="search-results" class="overflow-y-auto flex-1 px-4 py-3 space-y-2"></div>

      <div class="px-6 py-3 border-t border-gray-800 text-xs text-gray-600">
        Results from TMDB · Click a title to add it
      </div>
    </div>
  </div>

  <!-- Confirm Delete Modal -->
  <div id="delete-modal" class="modal-backdrop hidden fixed inset-0 bg-black/70 z-50 flex items-center justify-center p-4">
    <div class="bg-gray-900 border border-gray-700 rounded-2xl w-full max-w-sm shadow-2xl p-6">
      <h2 class="text-base font-semibold text-white mb-2">Delete item?</h2>
      <p class="text-sm text-gray-400 mb-6">This will remove the item from Netflix Top. This action cannot be undone.</p>
      <div class="flex gap-3">
        <button id="confirm-delete" class="flex-1 bg-red-600 hover:bg-red-500 text-white text-sm font-medium py-2.5 rounded-lg transition-colors">Delete</button>
        <button id="cancel-delete" class="flex-1 bg-gray-800 hover:bg-gray-700 text-white text-sm font-medium py-2.5 rounded-lg transition-colors">Cancel</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const API = '/api/netflix-top';
  const TMDB_SEARCH = '/api/tmdb-search';
  const IMG_BASE = 'https://image.tmdb.org/t/p/w92';

  let pendingDeleteId: number | null = null;
  let editingId: number | null = null;

  const searchModal = document.getElementById('search-modal')!;
  const deleteModal = document.getElementById('delete-modal')!;
  const addBtn = document.getElementById('add-btn')!;
  const closeModal = document.getElementById('close-modal')!;
  const cancelDelete = document.getElementById('cancel-delete')!;
  const confirmDelete = document.getElementById('confirm-delete')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('search-btn')!;
  const searchResults = document.getElementById('search-results')!;
  const searchStatus = document.getElementById('search-status')!;
  const modalTitle = document.getElementById('modal-title')!;

  function openSearchModal(replacing: boolean, id?: number) {
    editingId = replacing ? (id ?? null) : null;
    modalTitle.textContent = replacing ? 'Replace Item' : 'Add Netflix Top Item';
    searchInput.value = '';
    searchResults.innerHTML = '';
    searchStatus.textContent = '';
    searchModal.classList.remove('hidden');
    searchInput.focus();
  }

  function closeSearchModal() {
    searchModal.classList.add('hidden');
    editingId = null;
  }

  addBtn.addEventListener('click', () => openSearchModal(false));
  closeModal.addEventListener('click', closeSearchModal);
  searchModal.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearchModal();
  });

  async function doSearch() {
    const q = searchInput.value.trim();
    if (!q) return;
    searchStatus.textContent = 'Searching…';
    searchResults.innerHTML = '';
    try {
      const res = await fetch(`${TMDB_SEARCH}?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      if (!data.results?.length) {
        searchStatus.textContent = 'No results found.';
        return;
      }
      searchStatus.textContent = `${data.results.length} result${data.results.length !== 1 ? 's' : ''}`;
      searchResults.innerHTML = data.results
        .map((r: any) => {
          const title = r.title ?? r.name ?? 'Unknown';
          const year = (r.release_date ?? r.first_air_date ?? '').slice(0, 4);
          const poster = r.poster_path ? `${IMG_BASE}${r.poster_path}` : '/placeholder-poster.svg';
          const type = r.media_type;
          return `
            <button
              class="result-row w-full flex items-center gap-3 text-left px-3 py-2.5 rounded-xl hover:bg-gray-800 transition-colors"
              data-id="${r.id}" data-type="${type}" data-title="${title.replace(/"/g, '&quot;')}"
            >
              <img src="${poster}" alt="${title}" class="w-10 h-14 object-cover rounded-md shrink-0" loading="lazy" />
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-white truncate">${title}</p>
                <p class="text-xs text-gray-500">${year} · <span class="${type === 'movie' ? 'text-indigo-400' : 'text-emerald-400'} uppercase font-semibold">${type}</span></p>
              </div>
              <span class="text-xs text-gray-600 shrink-0">Add →</span>
            </button>
          `;
        })
        .join('');

      searchResults.querySelectorAll('.result-row').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const tmdb_id = (btn as HTMLElement).dataset.id!;
          const type = (btn as HTMLElement).dataset.type as 'movie' | 'tv';
          await saveItem(tmdb_id, type);
        });
      });
    } catch {
      searchStatus.textContent = 'Search failed. Try again.';
    }
  }

  searchBtn.addEventListener('click', doSearch);
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') doSearch();
  });

  async function saveItem(tmdb_id: string, type: 'movie' | 'tv') {
    try {
      if (editingId !== null) {
        await fetch(API, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: editingId, tmdb_id, type }),
        });
      } else {
        await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tmdb_id, type }),
        });
      }
      closeSearchModal();
      window.location.reload();
    } catch {
      alert('Failed to save item. Please try again.');
    }
  }

  function openDeleteModal(id: number) {
    pendingDeleteId = id;
    deleteModal.classList.remove('hidden');
  }

  cancelDelete.addEventListener('click', () => {
    deleteModal.classList.add('hidden');
    pendingDeleteId = null;
  });
  deleteModal.addEventListener('click', (e) => {
    if (e.target === deleteModal) {
      deleteModal.classList.add('hidden');
      pendingDeleteId = null;
    }
  });

  confirmDelete.addEventListener('click', async () => {
    if (pendingDeleteId === null) return;
    try {
      await fetch(API, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: pendingDeleteId }),
      });
      deleteModal.classList.add('hidden');
      pendingDeleteId = null;
      window.location.reload();
    } catch {
      alert('Failed to delete item.');
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.replace-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.id);
      openSearchModal(true, id);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.id);
      openDeleteModal(id);
    });
  });
</script>
