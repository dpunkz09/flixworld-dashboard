---
import Layout from '../layouts/Layout.astro';
import { getNetflixTopShowItems } from '../lib/supabase';
import { enrichItems, posterUrl, displayTitle, displayYear } from '../lib/tmdb';
import type { SupabaseItem } from '../lib/supabase';
import type { TmdbMedia } from '../lib/tmdb';

let items: SupabaseItem[] = [];
let enriched: (TmdbMedia | null)[] = [];
let error = '';

try {
  items = await getNetflixTopShowItems();
  enriched = await enrichItems(items);
} catch (e: any) {
  error = e.message;
}
---

<Layout title="Netflix Top Shows">
  {error && (
    <div class="mb-6 rounded-lg bg-red-900/40 border border-red-700 px-4 py-3 text-red-300 text-sm flex items-center gap-2">
      <span class="material-icons text-red-400" style="font-size:18px">warning</span>
      {error}
    </div>
  )}

  <!-- Toolbar -->
  <div class="flex items-center justify-between mb-5">
    <p class="text-sm text-gray-400">{items.length} item{items.length !== 1 ? 's' : ''} in Netflix Top Shows</p>
    <button
      id="add-btn"
      class="flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white text-sm font-medium px-4 py-2 rounded-lg transition-colors"
    >
      <span class="material-icons" style="font-size:18px">add</span>
      Add Item
    </button>
  </div>

  <!-- Ranked list -->
  <div id="items-grid" class="flex flex-col divide-y divide-gray-800 rounded-xl border border-gray-800 overflow-hidden">
    {items.map((item, i) => {
      const meta = enriched[i];
      const title = meta ? displayTitle(meta) : `TMDB #${item.tmdb_id}`;
      const year = meta ? displayYear(meta) : '—';
      const poster = meta ? posterUrl(meta.poster_path) : '/placeholder-poster.svg';
      const rank = i + 1;
      return (
        <div
          class="media-card flex items-center gap-3 px-3 py-2.5 bg-gray-900 hover:bg-gray-800/60 transition-colors"
          data-id={item.id}
          data-tmdb-id={item.tmdb_id}
          data-type={item.type}
        >
          <!-- Rank -->
          <span class="w-6 text-center text-sm font-black text-gray-500 shrink-0">{rank}</span>
          <!-- Thumbnail -->
          <img
            src={poster}
            alt={title}
            class="w-10 h-14 object-cover rounded-md shrink-0"
            loading="lazy"
          />
          <!-- Info -->
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-white truncate" title={title}>{title}</p>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="text-xs text-gray-500">{year}</span>
              <span class={`text-xs font-bold uppercase px-1.5 py-0.5 rounded-full ${item.type === 'movie' ? 'bg-indigo-600 text-white' : 'bg-emerald-600 text-white'}`}>
                {item.type}
              </span>
            </div>
          </div>
          <!-- Actions -->
          <div class="flex items-center gap-1 shrink-0">
            <button
              class="replace-btn flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-emerald-400 hover:bg-emerald-600 hover:text-white active:bg-emerald-700 transition-colors"
              data-id={item.id}
              data-tmdb-id={item.tmdb_id}
              data-type={item.type}
              aria-label="Replace"
            >
              <span class="material-icons" style="font-size:15px">swap_horiz</span>
              <span class="hidden sm:inline">Replace</span>
            </button>
            <button
              class="delete-btn flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-gray-400 hover:bg-gray-700 hover:text-white active:bg-gray-600 transition-colors"
              data-id={item.id}
              aria-label="Delete"
            >
              <span class="material-icons" style="font-size:15px">delete</span>
              <span class="hidden sm:inline">Delete</span>
            </button>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Empty state -->
  {items.length === 0 && !error && (
    <div class="flex flex-col items-center justify-center py-24 text-gray-600">
      <span class="material-icons text-gray-700 mb-4" style="font-size:56px">tv</span>
      <p class="text-lg">No Netflix Top Shows yet</p>
      <p class="text-sm mt-1">Tap <strong class="text-gray-400">Add Item</strong> to get started</p>
    </div>
  )}

  <!-- ── Modals ── -->

  <!-- Search / Add Modal -->
  <div id="search-modal" class="modal-backdrop hidden fixed inset-0 bg-black/70 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="modal-box bg-gray-900 border border-gray-700 rounded-t-2xl sm:rounded-2xl w-full sm:max-w-2xl shadow-2xl flex flex-col max-h-[92vh] sm:max-h-[90vh]">
      <div class="flex items-center justify-between px-5 py-4 border-b border-gray-800">
        <h2 class="text-base font-semibold text-white" id="modal-title">Add Netflix Top Show</h2>
        <button id="close-modal" class="text-gray-500 hover:text-white flex items-center">
          <span class="material-icons" style="font-size:20px">close</span>
        </button>
      </div>

      <div class="px-5 py-4 border-b border-gray-800">
        <div class="flex gap-2">
          <input
            id="search-input"
            type="text"
            placeholder="Search movies & TV shows…"
            class="flex-1 bg-gray-800 border border-gray-700 rounded-lg px-4 py-2.5 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500"
          />
          <button id="search-btn" class="flex items-center gap-1 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors">
            <span class="material-icons" style="font-size:18px">search</span>
            <span class="hidden sm:inline">Search</span>
          </button>
        </div>
        <p id="search-status" class="text-xs text-gray-500 mt-2 min-h-[16px]"></p>
      </div>

      <div id="search-results" class="overflow-y-auto flex-1 px-4 py-3 space-y-2"></div>

      <div class="px-5 py-3 border-t border-gray-800 text-xs text-gray-600">
        Results from TMDB · Tap a title to add it
      </div>
    </div>
  </div>

  <!-- Confirm Delete Modal -->
  <div id="delete-modal" class="modal-backdrop hidden fixed inset-0 bg-black/70 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-gray-900 border border-gray-700 rounded-t-2xl sm:rounded-2xl w-full sm:max-w-sm shadow-2xl p-6">
      <div class="flex items-center gap-2 mb-2">
        <span class="material-icons text-red-400" style="font-size:20px">delete_forever</span>
        <h2 class="text-base font-semibold text-white">Delete item?</h2>
      </div>
      <p class="text-sm text-gray-400 mb-6">This will remove the item from Netflix Top Shows. This action cannot be undone.</p>
      <div class="flex gap-3">
        <button id="confirm-delete" class="flex-1 bg-red-600 hover:bg-red-500 text-white text-sm font-medium py-2.5 rounded-lg transition-colors">Delete</button>
        <button id="cancel-delete" class="flex-1 bg-gray-800 hover:bg-gray-700 text-white text-sm font-medium py-2.5 rounded-lg transition-colors">Cancel</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  const API = '/api/netflix-top-show';
  const TMDB_SEARCH = '/api/tmdb-search';
  const IMG_BASE = 'https://image.tmdb.org/t/p/w92';

  let pendingDeleteId: number | null = null;
  let editingId: number | null = null;

  const searchModal = document.getElementById('search-modal')!;
  const deleteModal = document.getElementById('delete-modal')!;
  const addBtn = document.getElementById('add-btn')!;
  const closeModal = document.getElementById('close-modal')!;
  const cancelDelete = document.getElementById('cancel-delete')!;
  const confirmDelete = document.getElementById('confirm-delete')!;
  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const searchBtn = document.getElementById('search-btn')!;
  const searchResults = document.getElementById('search-results')!;
  const searchStatus = document.getElementById('search-status')!;
  const modalTitle = document.getElementById('modal-title')!;

  function openSearchModal(replacing: boolean, id?: number) {
    editingId = replacing ? (id ?? null) : null;
    modalTitle.textContent = replacing ? 'Replace Item' : 'Add Netflix Top Show';
    searchInput.value = '';
    searchResults.innerHTML = '';
    searchStatus.textContent = '';
    searchModal.classList.remove('hidden');
    searchInput.focus();
  }

  function closeSearchModal() {
    searchModal.classList.add('hidden');
    editingId = null;
  }

  addBtn.addEventListener('click', () => openSearchModal(false));
  closeModal.addEventListener('click', closeSearchModal);
  searchModal.addEventListener('click', (e) => {
    if (e.target === searchModal) closeSearchModal();
  });

  async function doSearch() {
    const q = searchInput.value.trim();
    if (!q) return;
    searchStatus.textContent = 'Searching…';
    searchResults.innerHTML = '';
    try {
      const res = await fetch(`${TMDB_SEARCH}?q=${encodeURIComponent(q)}`);
      const data = await res.json();
      if (!data.results?.length) {
        searchStatus.textContent = 'No results found.';
        return;
      }
      searchStatus.textContent = `${data.results.length} result${data.results.length !== 1 ? 's' : ''}`;
      searchResults.innerHTML = data.results
        .map((r: any) => {
          const title = r.title ?? r.name ?? 'Unknown';
          const year = (r.release_date ?? r.first_air_date ?? '').slice(0, 4);
          const poster = r.poster_path ? `${IMG_BASE}${r.poster_path}` : '/placeholder-poster.svg';
          const type = r.media_type;
          return `
            <button
              class="result-row w-full flex items-center gap-3 text-left px-3 py-2.5 rounded-xl hover:bg-gray-800 active:bg-gray-800 transition-colors"
              data-id="${r.id}" data-type="${type}" data-title="${title.replace(/"/g, '&quot;')}"
            >
              <img src="${poster}" alt="${title}" class="w-10 h-14 object-cover rounded-md shrink-0" loading="lazy" />
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-white truncate">${title}</p>
                <p class="text-xs text-gray-500">${year} · <span class="${type === 'movie' ? 'text-indigo-400' : 'text-emerald-400'} uppercase font-semibold">${type}</span></p>
              </div>
              <span class="material-icons text-gray-600 shrink-0" style="font-size:18px">add_circle_outline</span>
            </button>
          `;
        })
        .join('');

      // Delegated listener — avoids re-attaching to every row on each search
      searchResults.onclick = async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('.result-row');
        if (!btn) return;
        const tmdb_id = btn.dataset.id!;
        const type = btn.dataset.type as 'movie' | 'tv';
        await saveItem(tmdb_id, type);
      };
    } catch {
      searchStatus.textContent = 'Search failed. Try again.';
    }
  }

  searchBtn.addEventListener('click', doSearch);
  searchInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') doSearch();
  });

  async function saveItem(tmdb_id: string, type: 'movie' | 'tv') {
    try {
      if (editingId !== null) {
        await fetch(API, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: editingId, tmdb_id, type }),
        });
      } else {
        await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tmdb_id, type }),
        });
      }
      closeSearchModal();
      window.location.reload();
    } catch {
      alert('Failed to save item. Please try again.');
    }
  }

  function openDeleteModal(id: number) {
    pendingDeleteId = id;
    deleteModal.classList.remove('hidden');
  }

  cancelDelete.addEventListener('click', () => {
    deleteModal.classList.add('hidden');
    pendingDeleteId = null;
  });
  deleteModal.addEventListener('click', (e) => {
    if (e.target === deleteModal) {
      deleteModal.classList.add('hidden');
      pendingDeleteId = null;
    }
  });

  confirmDelete.addEventListener('click', async () => {
    if (pendingDeleteId === null) return;
    try {
      await fetch(API, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: pendingDeleteId }),
      });
      deleteModal.classList.add('hidden');
      pendingDeleteId = null;
      window.location.reload();
    } catch {
      alert('Failed to delete item.');
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.replace-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.id);
      openSearchModal(true, id);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = Number(btn.dataset.id);
      openDeleteModal(id);
    });
  });
</script>
