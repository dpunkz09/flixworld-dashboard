---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
const nav = [
  { href: '/',                 label: 'Dashboard', icon: 'dashboard' },
  { href: '/carousel',         label: 'Carousel',  icon: 'view_carousel' },
  { href: '/netflix-top',      label: 'Movies',    icon: 'local_fire_department' },
  { href: '/netflix-top-show', label: 'Shows',     icon: 'tv' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en" class="h-full bg-gray-950">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — FlixWorld Dashboard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" />
</head>
<body class="min-h-full text-gray-100 font-sans bg-gray-950 flex flex-col">

  <!-- Top app bar -->
  <header class="fixed top-0 inset-x-0 z-40 flex items-center gap-3 px-4 h-14 bg-gray-900 border-b border-gray-800 shadow-sm">
    <span class="material-icons text-indigo-400" style="font-size:22px">movie</span>
    <div class="flex-1 min-w-0">
      <span class="text-base font-bold tracking-tight text-white leading-none">FlixWorld</span>
      <span class="text-xs text-gray-500 ml-2 hidden sm:inline">Content Dashboard</span>
    </div>
    <h1 class="text-sm font-medium text-gray-300 truncate">{title}</h1>
  </header>

  <!-- Page content — padded away from top bar and bottom nav -->
  <main class="flex-1 px-4 py-4 mt-14 mb-16 sm:px-6 sm:py-6">
    <slot />
  </main>

  <!-- Bottom navigation bar -->
  <nav class="fixed bottom-0 inset-x-0 z-40 bg-gray-900 border-t border-gray-800 flex">
    {nav.map(({ href, label, icon }) => {
      const active = current === href || (href !== '/' && current.startsWith(href + '/'));
      return (
        <a
          href={href}
          class={`flex-1 flex flex-col items-center justify-center gap-0.5 py-2 text-xs font-medium transition-colors ${
            active
              ? 'text-indigo-400'
              : 'text-gray-500 hover:text-gray-300'
          }`}
        >
          <span class="material-icons" style="font-size:24px">{icon}</span>
          <span>{label}</span>
          {active && <span class="absolute bottom-0 w-10 h-0.5 bg-indigo-400 rounded-t-full" />}
        </a>
      );
    })}
  </nav>

</body>
</html>
