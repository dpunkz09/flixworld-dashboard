---
import '../styles/global.css';
interface Props { title: string }
const { title } = Astro.props;
const nav = [
  { href: '/', label: 'Dashboard' },
  { href: '/carousel', label: 'Carousel' },
  { href: '/netflix-top', label: 'Netflix Top' },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en" class="h-full bg-gray-950">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — FlixWorld Dashboard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="h-full text-gray-100 font-sans">
  <div class="flex h-full">
    <!-- Sidebar -->
    <aside class="w-56 shrink-0 bg-gray-900 border-r border-gray-800 flex flex-col">
      <div class="px-5 py-5 border-b border-gray-800">
        <span class="text-lg font-bold tracking-tight text-white">🎬 FlixWorld</span>
        <p class="text-xs text-gray-500 mt-0.5">Content Dashboard</p>
      </div>
      <nav class="flex-1 px-3 py-4 space-y-1">
        {nav.map(({ href, label }) => {
          const active = current === href || (href !== '/' && current.startsWith(href));
          return (
            <a
              href={href}
              class={`flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
                active
                  ? 'bg-indigo-600 text-white'
                  : 'text-gray-400 hover:bg-gray-800 hover:text-white'
              }`}
            >
              {href === '/' && '🏠'}
              {href === '/carousel' && '🎠'}
              {href === '/netflix-top' && '🔥'}
              {label}
            </a>
          );
        })}
      </nav>
      <div class="px-4 py-3 border-t border-gray-800 text-xs text-gray-600">
        Powered by Supabase + TMDB
      </div>
    </aside>

    <!-- Main -->
    <div class="flex-1 flex flex-col min-w-0 overflow-auto">
      <header class="shrink-0 px-8 py-4 border-b border-gray-800 bg-gray-900/60 backdrop-blur">
        <h1 class="text-xl font-semibold text-white">{title}</h1>
      </header>
      <main class="flex-1 px-8 py-6">
        <slot />
      </main>
    </div>
  </div>
</body>
</html>
